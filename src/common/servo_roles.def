/* name, enum suffix, index, bits, is_tx, CoE type, base, speed, custom_required, standard, handle
 * Order of standard entries is also used by the legacy multi-axis binding. */
SERVO_ROLE(status_word, STATUS_WORD, 0x6041, 16, 1, UINT, 1, 0, 1, 1, statusWord)
SERVO_ROLE(actual_pos, ACTUAL_POS, 0x6064, 32, 1, DINT, 1, 0, 1, 1, act_pos)
SERVO_ROLE(error_code, ERROR_CODE, 0x603F, 16, 1, UINT, 0, 0, 1, 1, error_code)
SERVO_ROLE(mode_display, MODE_DISPLAY, 0x6061, 8, 1, SINT, 1, 0, 1, 1, act_mode)
SERVO_ROLE(actual_speed, ACTUAL_SPEED, 0x606C, 32, 1, DINT, 0, 1, 1, 1, act_speed)
SERVO_ROLE(actual_torque, ACTUAL_TORQUE, 0x6077, 16, 1, INT, 0, 0, 0, 1, act_torque)
SERVO_ROLE(control_word, CONTROL_WORD, 0x6040, 16, 0, UINT, 1, 0, 1, 1, Control_word)
SERVO_ROLE(target_pos, TARGET_POS, 0x607A, 32, 0, DINT, 1, 0, 1, 1, target_pos)
SERVO_ROLE(target_speed, TARGET_SPEED, 0x60FF, 32, 0, DINT, 0, 1, 1, 1, target_speed)
SERVO_ROLE(op_mode, OP_MODE, 0x6060, 8, 0, SINT, 1, 0, 1, 1, Modes_of_operation)
SERVO_ROLE(target_torque, TARGET_TORQUE, 0x6071, 16, 0, INT, 0, 0, 0, 0, target_torque)
